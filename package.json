{
  "name": "sherlock-zed-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "test": "node --test --test-concurrency=1 server/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p server/tsconfig.build.json",
    "start": "node server/dist/main.js --stdio",
    "test:release": "node --test scripts/*.test.mjs",
    "release:build": "npm run build && node scripts/build-release.mjs",
    "release:smoke": "node scripts/smoke-release.mjs"
  },
  "dependencies": {
    "@inlang/sdk": "4.0.4",
    "@inlang/plugin-message-format": "4.5.0",
    "message-format-4-4": "npm:@inlang/plugin-message-format@4.4.0",
    "memfs": "4.6.0",
    "typescript": "5.9.3",
    "vscode-languageserver": "10.1.2",
    "vscode-languageserver-textdocument": "1.0.15"
  },
  "devDependencies": { "@types/node": "26.6.5" },
  "overrides": { "@inlang/sdk": "4.0.4" }
}
